# AI calls. Course key routes through Portkey; OPENAI_API_KEY is used only if PORTKEY_API_KEY is absent.
PORTKEY_API_KEY=
OPENAI_API_KEY=
# Optional. Defaults to gpt-6-luna (the course key's model).
OPENAI_MODEL=
# Optional: SEC EDGAR contact for the User-Agent header ("<app name> <email>"). A project default is built in.
SEC_USER_AGENT=
